# OpenAI API 키 (LLM Agent: 법적 근거/내용증명/실행계획 생성용)
OPENAI_API_KEY=sk-...

# 로컬 개발 시 ML 추론 스크립트를 실행할 Python 인터프리터 경로 (선택)
# 미지정 시 python -> python3 순서로 자동 탐색
PYTHON_BIN=python

# 공정거래위원회 1372 소비자상담 API 서비스키 (data.go.kr 마이페이지 활용신청 상세에서 확인,
# scripts/fetch_1372_api.py가 public/consumer_stats.json 대시보드 데이터를 갱신할 때만 사용)
DATA_GO_KR_SERVICE_KEY=...
